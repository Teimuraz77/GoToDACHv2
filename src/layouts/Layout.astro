---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { alternatePath, getLangFromUrl } from '../i18n/utils';
import { getImage } from 'astro:assets';
import temo from '../assets/temo.jpg';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const canonical = new URL(Astro.url.pathname, Astro.site);
const barePath = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const ogImage = await getImage({ src: temo, width: 1200, format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, Astro.site);

// Strukturierte Daten für Suchmaschinen: nur belegte Fakten aus Impressum und Über-Temo-Seite.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'GoToDACH',
  url: 'https://gotodach.com',
  email: 'temo@gotodach.com',
  telephone: '+49 172 3196188',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Schlossstraße 28',
    postalCode: '60486',
    addressLocality: 'Frankfurt am Main',
    addressCountry: 'DE',
  },
  areaServed: ['DE', 'AT', 'CH'],
  founder: {
    '@type': 'Person',
    name: 'Teimuraz Gogodze',
    alternateName: 'Temo',
    knowsLanguage: ['de', 'en', 'ru'],
  },
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="theme-color" content="#0e1a2e" />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="GoToDACH" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'de_DE'} />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<link rel="alternate" hreflang="de" href={new URL(alternatePath(barePath, 'de'), Astro.site)} />
		<link rel="alternate" hreflang="en" href={new URL(alternatePath(barePath, 'en'), Astro.site)} />
		<link rel="alternate" hreflang="x-default" href={new URL(alternatePath(barePath, 'de'), Astro.site)} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip" href="#inhalt">{lang === 'en' ? 'Skip to content' : 'Zum Inhalt springen'}</a>
		<Header />
		<main id="inhalt">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	.skip {
		position: absolute;
		left: 1rem;
		top: -3rem;
		background: var(--color-paper);
		color: var(--color-base);
		padding: 0.5rem 0.75rem;
		z-index: 10;
	}

	.skip:focus {
		top: 1rem;
	}
</style>
