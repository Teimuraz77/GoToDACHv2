---
import Layout from '../../layouts/Layout.astro';
import MarketIntelView from '../../components/MarketIntelView.astro';
import { miTranslated, useTranslations } from '../../i18n/utils';

const t = useTranslations('es');
---

<Layout
	title={t('mi.meta.title')}
	description={t('mi.meta.description')}
	noindex={!miTranslated.includes('es')}
	alternateLangs={miTranslated}
>
	<MarketIntelView lang="es" />
</Layout>
