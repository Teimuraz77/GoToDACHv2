---
import type { Lang } from '../i18n/ui';
import { copy } from '../i18n/copy';
import { localePath } from '../i18n/utils';

interface Props {
  lang: Lang;
  kind: 'imprint' | 'privacy';
}

const { lang, kind } = Astro.props;
const c = copy[lang];

// Rechtstexte sind übersetzt; verbindlich bleibt die deutsche Fassung (Hinweis + Link auf allen anderen Sprachen).
// Fehlt eine Übersetzung, wird der deutsche Text angezeigt.
const isGerman = lang === 'de';
const src = kind === 'imprint' ? c.imprint : c.privacy;
const fallback = kind === 'imprint' ? copy.de.imprint : copy.de.privacy;
const translated = src.sections.length > 0;
const h1 = src.h1;
const sections = translated ? src.sections : fallback.sections;
const lead = kind === 'imprint' ? (translated ? c.imprint.lead : copy.de.imprint.lead) : '';
const deHref = localePath('de', kind === 'imprint' ? 'impressum' : 'datenschutz');
---

<article class="page">
	<header class="intro">
		<h1>{h1}</h1>
		{!isGerman && (
			<p class="note">
				{c.legalNotice} <a href={deHref} hreflang="de" lang="de">{c.legalNoticeLink || 'Deutsche Fassung'}</a>
			</p>
		)}
		{lead && <p class="note">{lead}</p>}
	</header>

	<div lang={translated ? lang : 'de'}>
		{sections.map((s) => (
			<section class="block">
				<h2>{s.title}</h2>
				<div class="body">
					{s.paragraphs.map((p) => (
						<p>{p}</p>
					))}
				</div>
			</section>
		))}
	</div>
</article>

<style>
	.page {
		max-width: 72rem;
		margin: 0 auto;
		padding-inline: 1rem;
	}

	.intro {
		padding-block: 3rem 2.5rem;
		display: grid;
		gap: 1rem;
	}

	.intro h1 {
		font-size: clamp(2rem, 6.5vw, 3.75rem);
		line-height: 1.1;
	}

	.note {
		color: var(--color-muted);
		font-size: 0.95rem;
	}

	.block {
		border-top: 1px solid var(--color-line);
		padding-block: 2rem;
		display: grid;
		gap: 0.75rem;
	}

	.block h2 {
		font-size: 1.4rem;
	}

	.body {
		display: grid;
		gap: 0.5rem;
	}

	.todo {
		color: var(--color-muted);
		font-size: 0.95rem;
	}

	.action {
		margin: 0;
	}

	@media (min-width: 48rem) {
		.page {
			padding-inline: 2rem;
		}

		.intro {
			padding-block: 6rem 3rem;
		}

		.block {
			padding-block: 2.5rem;
			grid-template-columns: 1fr 2fr;
			gap: 3rem;
		}

		.block > h2 {
			align-self: start;
		}

		.block > .body,
		.block > .action,
		.block > .todo {
			grid-column: 2;
		}
	}
</style>
