---
import type { Lang } from '../i18n/ui';
import { copy } from '../i18n/copy';

interface Props {
  lang: Lang;
  kind: 'imprint' | 'privacy';
}

const { lang, kind } = Astro.props;
const c = copy[lang];

// Rechtstexte gibt es nur auf Deutsch (verbindlich). Andere Sprachen zeigen den deutschen Text
// direkt an, mit einem Hinweis in der jeweiligen Sprache darüber.
const isGerman = lang === 'de';
const de = copy.de;
const h1 = kind === 'imprint' ? c.imprint.h1 : c.privacy.h1;
const sections = kind === 'imprint' ? de.imprint.sections : de.privacy.sections;
const lead = kind === 'imprint' ? de.imprint.lead : '';
---

<article class="page">
	<header class="intro">
		<h1>{h1}</h1>
		{!isGerman && <p class="note">{c.legalNotice}</p>}
		{lead && <p class="note" lang="de">{lead}</p>}
	</header>

	<div lang="de">
		{sections.map((s) => (
			<section class="block">
				<h2>{s.title}</h2>
				<div class="body">
					{s.paragraphs.map((p) => (
						<p>{p}</p>
					))}
				</div>
			</section>
		))}
	</div>
</article>

<style>
	.page {
		max-width: 72rem;
		margin: 0 auto;
		padding-inline: 1rem;
	}

	.intro {
		padding-block: 3rem 2.5rem;
		display: grid;
		gap: 1rem;
	}

	.intro h1 {
		font-size: clamp(2rem, 6.5vw, 3.75rem);
		line-height: 1.1;
	}

	.note {
		color: var(--color-muted);
		font-size: 0.95rem;
	}

	.block {
		border-top: 1px solid var(--color-line);
		padding-block: 2rem;
		display: grid;
		gap: 0.75rem;
	}

	.block h2 {
		font-size: 1.4rem;
	}

	.body {
		display: grid;
		gap: 0.5rem;
	}

	.todo {
		color: var(--color-muted);
		font-size: 0.95rem;
	}

	.action {
		margin: 0;
	}

	@media (min-width: 48rem) {
		.page {
			padding-inline: 2rem;
		}

		.intro {
			padding-block: 6rem 3rem;
		}

		.block {
			padding-block: 2.5rem;
			grid-template-columns: 1fr 2fr;
			gap: 3rem;
		}

		.block > h2 {
			align-self: start;
		}

		.block > .body,
		.block > .action,
		.block > .todo {
			grid-column: 2;
		}
	}
</style>
