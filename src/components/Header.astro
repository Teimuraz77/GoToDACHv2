---
import { alternatePath, getLangFromUrl, localePath, stripLang, useTranslations } from '../i18n/utils';
import { languages, type Lang } from '../i18n/ui';
import Flag from './Flag.astro';
import logo from '../assets/logo.png';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Pfad ohne Sprachpräfix, damit das Sprachmenü auf dieselbe Seite in der anderen Sprache zeigt.
const barePath = stripLang(Astro.url.pathname);
const langList = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  name: languages[code],
  href: alternatePath(barePath, code),
}));
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (current === localePath(lang, href) ? 'page' : undefined);

const nav = [
  { key: 'nav.goToMarket', href: 'go-to-market' },
  { key: 'nav.talent', href: 'talent' },
  { key: 'nav.renewable', href: 'renewable-energy' },
  { key: 'nav.about', href: 'ueber-temo' },
] as const;
---

<header class="site-header">
	<div class="bar">
		<a class="brand" href={localePath(lang)}>
			<img src={logo.src} width={logo.width} height={logo.height} alt="GoToDACH" />
		</a>
		<nav aria-label={t('nav.main')}>
			<ul>
				{nav.map((item) => (
					<li><a href={localePath(lang, item.href)} aria-current={isCurrent(item.href)}>{t(item.key)}</a></li>
				))}
				<li><a href={localePath(lang, 'kontakt')} aria-current={isCurrent('kontakt')}>{t('nav.contact')}</a></li>
			</ul>
		</nav>
		<details class="lang">
			<summary aria-label={`${t('lang.switch')}: ${languages[lang]}`}>
				<Flag code={lang} />
				<span class="code">{lang.toUpperCase()}</span>
				<span class="caret" aria-hidden="true"></span>
			</summary>
			<ul class="lang-list">
				{langList.map((l) => (
					<li>
						<a href={l.href} hreflang={l.code} lang={l.code} aria-current={l.code === lang ? 'true' : undefined}>
							<Flag code={l.code} />
							<span>{l.name}</span>
						</a>
					</li>
				))}
			</ul>
		</details>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--color-line);
	}

	.bar {
		display: grid;
		gap: 0.75rem 1.5rem;
		grid-template-columns: 1fr auto;
		align-items: center;
		padding: 1rem 1rem 0.75rem;
		max-width: 72rem;
		margin: 0 auto;
	}

	.brand {
		display: inline-block;
		line-height: 0;
	}

	.brand img {
		height: 3.75rem;
		width: auto;
	}

	@media (min-width: 48rem) {
		.brand img {
			height: 4.5rem;
		}
	}

	.brand:hover img {
		opacity: 0.8;
	}

	nav {
		grid-column: 1 / -1;
		order: 3;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
	}

	nav a {
		color: var(--color-paper);
		text-decoration: none;
		font-size: 0.95rem;
		padding: 0.25rem 0;
		display: inline-block;
	}

	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--color-copper);
	}

	.lang {
		position: relative;
		justify-self: end;
		font-size: 0.95rem;
	}

	.lang summary {
		list-style: none;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		cursor: pointer;
		padding: 0.35rem 0.6rem;
		border: 1px solid var(--color-line);
		color: var(--color-paper);
		user-select: none;
	}

	.lang summary::-webkit-details-marker {
		display: none;
	}

	.lang summary:hover,
	.lang[open] summary {
		border-color: var(--color-copper);
	}

	.lang .caret {
		width: 0.4rem;
		height: 0.4rem;
		border-right: 1.5px solid var(--color-copper);
		border-bottom: 1.5px solid var(--color-copper);
		transform: translateY(-0.15rem) rotate(45deg);
	}

	.lang[open] .caret {
		transform: translateY(0.1rem) rotate(-135deg);
	}

	.lang-list {
		position: absolute;
		right: 0;
		top: calc(100% + 0.35rem);
		z-index: 20;
		min-width: 10rem;
		display: grid;
		gap: 0;
		padding: 0.35rem 0;
		background: var(--color-deep);
		border: 1px solid var(--color-line);
		box-shadow: 0 12px 30px rgb(0 0 0 / 0.35);
	}

	.lang-list a {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.5rem 0.9rem;
		color: var(--color-paper);
		text-decoration: none;
	}

	.lang-list a:hover {
		background: var(--color-base);
		color: var(--color-copper);
	}

	.lang-list a[aria-current='true'] {
		color: var(--color-copper);
	}

	@media (min-width: 48rem) {
		.bar {
			grid-template-columns: auto 1fr auto;
			padding: 1.25rem 2rem;
		}

		nav {
			grid-column: auto;
			order: 0;
		}

		ul {
			justify-content: flex-end;
			gap: 0.25rem 1.75rem;
		}
	}
</style>

<script is:inline>
	// Sprachmenü bei Klick außerhalb oder Escape schließen
	document.addEventListener('click', function (e) {
		document.querySelectorAll('details.lang[open]').forEach(function (d) {
			if (!d.contains(e.target)) d.removeAttribute('open');
		});
	});
	document.addEventListener('keydown', function (e) {
		if (e.key !== 'Escape') return;
		document.querySelectorAll('details.lang[open]').forEach(function (d) {
			d.removeAttribute('open');
			d.querySelector('summary').focus();
		});
	});
</script>
