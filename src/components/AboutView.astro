---
import { localePath, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { copy } from '../i18n/copy';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const c = copy[lang].about;
---

<article class="page">
	<header class="intro">
		<h1>{c.headline}</h1>
		<div class="lede">
			{c.intro.map((p) => <p>{p}</p>)}
		</div>
	</header>

	<section class="block">
		<!-- TODO offen: Anzahl der Jahre im B2B-Vertrieb im Intro ergänzen; 2–3 konkrete Stationen/Branchen (ohne vertrauliche Kundennamen) und Sprachen ergänzen; CoRe (NIS2-Compliance-as-a-Service) erwähnen – ja/nein? -->
		<h2>{c.bringTitle}</h2>
		<ul>
			{c.bring.map((item) => <li>{item}</li>)}
		</ul>
	</section>

	<section class="block">
		<h2>{c.wayTitle}</h2>
		<p>{c.way}</p>
	</section>

	<section class="block photo">
		<!-- TODO: Porträtfoto liefern (Querformat oder 4:5, mind. 1200 px breit), dann nach src/assets/temo.jpg und Platzhalter ersetzen -->
		<div class="placeholder" aria-hidden="true">TG</div>
	</section>

	<section class="block cta">
		<h2>{t('about.contact.title')}</h2>
		<div class="body">
			<p>{t('about.contact.text')}</p>
			<p class="action">
				<!-- TODO: Calendly-Link, sobald Temo ihn freigibt -->
				<a href="mailto:temo@gotodach.com">{t('home.cta')}</a>
			</p>
		</div>
	</section>
</article>

<style>
	.page {
		max-width: 72rem;
		margin: 0 auto;
		padding-inline: 1rem;
	}

	.intro {
		padding-block: 3rem 2.5rem;
		display: grid;
		gap: 1.5rem;
	}

	.intro h1 {
		font-size: clamp(2rem, 6.5vw, 3.75rem);
		line-height: 1.1;
		max-width: 22ch;
	}

	.lede {
		display: grid;
		gap: 1rem;
		color: var(--color-muted);
	}

	.block {
		border-top: 1px solid var(--color-line);
		padding-block: 2.5rem;
		display: grid;
		gap: 1.25rem;
	}

	.block h2 {
		font-size: 1.6rem;
	}

	ul {
		list-style: disc outside;
		margin: 0;
		padding-left: 1.1rem;
		display: grid;
		gap: 0.6rem;
	}

	li::marker {
		color: var(--color-copper);
	}

	.todo {
		color: var(--color-muted);
		font-size: 0.95rem;
	}

	.photo {
		justify-items: center;
		text-align: center;
	}

	.placeholder {
		width: 10rem;
		aspect-ratio: 4 / 5;
		display: grid;
		place-items: center;
		background: var(--color-deep);
		border: 1px solid var(--color-line);
		font-family: var(--font-display);
		font-size: 2.5rem;
		color: var(--color-copper);
	}

	.body {
		display: grid;
		gap: 1rem;
		align-content: start;
	}

	.cta .action {
		margin: 0;
	}

	.cta .action a {
		font-size: 1.05rem;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.3em;
	}

	@media (min-width: 48rem) {
		.page {
			padding-inline: 2rem;
		}

		.intro {
			padding-block: 6rem 4rem;
			grid-template-columns: 1.4fr 1fr;
			align-items: end;
			gap: 3rem;
		}

		.block {
			padding-block: 3.5rem;
			grid-template-columns: 1fr 2fr;
			gap: 3rem;
		}

		.block > h2 {
			align-self: start;
		}

		.block > :not(h2) {
			grid-column: 2;
		}

		.photo {
			grid-template-columns: auto 1fr;
			justify-items: start;
			align-items: center;
			text-align: left;
		}

		.photo > .placeholder {
			grid-column: 1;
		}

	}
</style>
