---
import { localePath, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import { copy } from '../i18n/copy';
import { Image } from 'astro:assets';
import temo from '../assets/temo.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const c = copy[lang].about;
const photoAlt = t('about.photoAlt');
---

<article class="page">
	<header class="intro">
		<h1>{c.headline}</h1>
		<div class="lede">
			{c.intro.map((p) => <p>{p}</p>)}
		</div>
	</header>

	<section class="block">
		<h2>{c.stationsTitle}</h2>
		<ol class="stations">
			{c.stations.map((st) => (
				<li>
					<p class="label">{st.label}</p>
					<h3>{st.title}</h3>
					<p>{st.text}</p>
				</li>
			))}
		</ol>
	</section>

	<section class="block">
		<h2>{c.bringTitle}</h2>
		<ul>
			{c.bring.map((item) => <li>{item}</li>)}
		</ul>
	</section>

	<section class="block">
		<h2>{c.wayTitle}</h2>
		<p>{c.way}</p>
	</section>

	<section class="block photo">
		<figure class="portrait">
			<Image src={temo} alt={photoAlt} widths={[640, 960, 1280]} sizes="(min-width: 48rem) 40rem, 100vw" quality={90} />
		</figure>
	</section>

	<section class="block cta">
		<h2>{t('about.contact.title')}</h2>
		<div class="body">
			<p>{t('about.contact.text')}</p>
			<p class="action">
				<a href={localePath(lang, 'kontakt')}>{t('home.cta')}</a>
			</p>
		</div>
	</section>
</article>

<style>
	.page {
		max-width: 72rem;
		margin: 0 auto;
		padding-inline: 1rem;
	}

	.intro {
		padding-block: 3rem 2.5rem;
		display: grid;
		gap: 1.5rem;
	}

	.intro h1 {
		font-size: clamp(2rem, 6.5vw, 3.75rem);
		line-height: 1.1;
		max-width: 22ch;
	}

	.lede {
		display: grid;
		gap: 1rem;
		color: var(--color-muted);
	}

	.block {
		border-top: 1px solid var(--color-line);
		padding-block: 2.5rem;
		display: grid;
		gap: 1.25rem;
	}

	.block h2 {
		font-size: 1.6rem;
	}

	ul {
		list-style: disc outside;
		margin: 0;
		padding-left: 1.1rem;
		display: grid;
		gap: 0.6rem;
	}

	li::marker {
		color: var(--color-copper);
	}

	.todo {
		color: var(--color-muted);
		font-size: 0.95rem;
	}

	.portrait {
		margin: 0;
		max-width: 40rem;
	}

	.portrait img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--color-line);
	}

	.stations {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 2rem;
	}

	.stations li {
		border-left: 1px solid var(--color-copper);
		padding-left: 1.25rem;
		display: grid;
		gap: 0.4rem;
	}

	.stations .label {
		margin: 0;
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-gold);
	}

	.stations h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.4rem;
		line-height: 1.2;
	}

	.stations li > p:last-child {
		margin: 0;
		color: var(--color-muted);
	}

	.body {
		display: grid;
		gap: 1rem;
		align-content: start;
	}

	.cta .action {
		margin: 0;
	}

	.cta .action a {
		font-size: 1.05rem;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.3em;
	}

	@media (min-width: 48rem) {
		.page {
			padding-inline: 2rem;
		}

		.intro {
			padding-block: 6rem 4rem;
			grid-template-columns: 1.4fr 1fr;
			align-items: end;
			gap: 3rem;
		}

		.block {
			padding-block: 3.5rem;
			grid-template-columns: 1fr 2fr;
			gap: 3rem;
		}

		.block > h2 {
			align-self: start;
		}

		.block > :not(h2) {
			grid-column: 2;
		}


	}
</style>
