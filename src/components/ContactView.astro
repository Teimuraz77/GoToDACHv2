---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import ContactForm from './ContactForm.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<article class="page">
	<header class="intro">
		<h1>{t('contact.h1')}</h1>
		<p class="lede">{t('contact.lede')}</p>
	</header>

	<section class="block">
		<h2>{t('contact.form.title')}</h2>
		<div class="stack">
			<ContactForm lang={lang} />
		</div>
	</section>

	<section class="block">
		<!-- TODO: Calendly-Link ergänzen, sobald vorhanden -->
		<h2>{t('contact.direct.title')}</h2>
		<div class="stack">
			<p>{t('contact.direct.text')}</p>
			<p class="action">
				<a href="mailto:temo@gotodach.com">temo@gotodach.com</a>
			</p>
			<p class="action">
				<a href="tel:+491723196188">+49 172 319 61 88</a>
			</p>
		</div>
	</section>
</article>

<style>
	.page {
		max-width: 72rem;
		margin: 0 auto;
		padding-inline: 1rem;
	}

	.intro {
		padding-block: 3rem 2.5rem;
		display: grid;
		gap: 1.5rem;
	}

	.intro h1 {
		font-size: clamp(2rem, 6.5vw, 3.75rem);
		line-height: 1.1;
		max-width: 20ch;
	}

	.lede {
		font-size: 1.1rem;
		color: var(--color-muted);
	}

	.block {
		border-top: 1px solid var(--color-line);
		padding-block: 2.5rem 3rem;
		display: grid;
		gap: 1.5rem;
	}

	.block h2 {
		font-size: 1.6rem;
	}

	.stack {
		display: grid;
		gap: 1rem;
	}

	.action {
		margin: 0;
	}

	.action a {
		font-size: 1.25rem;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.3em;
	}

	.todo {
		color: var(--color-muted);
		font-size: 0.95rem;
	}

	@media (min-width: 48rem) {
		.page {
			padding-inline: 2rem;
		}

		.intro {
			padding-block: 6rem 4rem;
			grid-template-columns: 1.4fr 1fr;
			align-items: end;
			gap: 3rem;
		}

		.block {
			padding-block: 4rem;
			grid-template-columns: 1fr 2fr;
			gap: 3rem;
		}

		.block > h2 {
			align-self: start;
		}

		.block > .stack {
			grid-column: 2;
		}
	}
</style>
